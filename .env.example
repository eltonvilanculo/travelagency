# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string used by Prisma (prisma7.config.ts).
# Local option: `npx prisma dev` spins up a local Postgres instance for you
# and prints a connection string to use here.
# Hosted option: Prisma Postgres (`npx create-db` or console.prisma.io) —
# the convention used across other projects on this Prisma generation.
#
# `npx create-db` prints the connection string inside a decorative box
# (lines prefixed with "|"). Copy ONLY the string itself — from "postgres://"
# to the end of the line — onto ONE line here, in quotes. Pasting the whole
# boxed block (or letting it wrap across lines) is the #1 cause of a
# "P1013: scheme is not recognized" error from `prisma migrate`.
#
# `create-db` databases are temporary — it also prints a "Claim Your
# Database" URL. Open that and claim it, or it's deleted within ~24h.
DATABASE_URL="postgresql://user:password@localhost:5432/zambitour?schema=public&sslmode=verify-full"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth. Generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# Bootstrap admin — creates the first Administrator account, then you can
# remove these three lines. Run: npm run admin:bootstrap
BOOTSTRAP_ADMIN_NAME="ZambiTour Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@zambitour.co.mz"
BOOTSTRAP_ADMIN_PASSWORD="zambitour123"

# Customer-facing sign-in (src/lib/customer-auth.ts) — a separate, second
# NextAuth instance from the admin one above, its own route (/api/auth —
# yes, the plain default path; see the long comment at the top of
# customer-auth.ts for why the admin instance is the one that moved to
# /api/admin-auth instead, not this one) and session cookie. Google and
# Facebook are both offered; a customer can use either one. REQUIRED as
# of 2026-09-16 — submitting a reservation (single-item or "Minha
# Viagem") now 401s without a session, so until at least one of these is
# configured, nobody can actually book. Browsing/building a trip stack
# still needs no account.
#
# Google: create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application") and add this exact redirect URI:
# {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook: create an app at https://developers.facebook.com/apps
# (add the "Facebook Login" product), and add this exact redirect URI
# under Facebook Login > Settings > Valid OAuth Redirect URIs:
# {NEXTAUTH_URL}/api/auth/callback/facebook
# The app also needs the "email" and "public_profile" permissions
# (granted by default) and, to go live for real users (not just
# admins/testers on the app), Meta's App Review for the "email"
# permission.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Payen — the M-Pesa/e-Mola payment gateway (src/lib/payments/). One
# application, one API key for all of Zambi Tour (not per-tour/per-release).
# Register the app once via Payen's /admin/apps setup, create its key, and
# put the plaintext key here. Until PAYEN_API_KEY is set, payment
# initiation fails with a clear error — reservations/quotes still work.
#
# IMPORTANT: an API key is scoped to the environment it was created in
# (confirmed live 2026-09-15) — a key created against the dev app returns
# "Invalid API key" on the production host below, and vice versa. Use
# whichever base URL matches where the current key's app was registered.
# The dev host does forward to the real M-Pesa/e-Mola provider (a real
# phone number gets a real STK-push-style prompt), it isn't a mock.
PAYEN_BASE_URL="https://payen.gestaosistema.com/v1"
# PAYEN_BASE_URL="https://dev.payen.gestaosistema.com/v1"
PAYEN_API_KEY="payen_replace_with_real_key"

# Reservation confirmation emails (src/lib/email.ts) — plain SMTP, no paid
# email API needed. Works with any mailbox: the business's own email,
# Gmail (use an app password, not the account password), Zoho, etc.
# Until these are set, emails are skipped and logged rather than sent —
# reservations still work fine without them.
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="bookings@zambitour.co.mz"
EMAIL_PASS="replace-with-real-smtp-password"
EMAIL_FROM="ZambiTour <bookings@zambitour.co.mz>"

# FAQ bot human handoff (src/lib/faq/human-handoff.ts, §11 RF-064) — Chatwoot's
# Public API for an "API Channel" inbox. Only the inbox's public identifier
# is needed, never an account-level API token. Until these are set, a
# low-confidence/human-requested question is still logged to FaqUnanswered
# for manual follow-up — the chat widget works without Chatwoot configured,
# it just can't open a live conversation there.
CHATWOOT_BASE_URL="https://app.chatwoot.com"
CHATWOOT_INBOX_IDENTIFIER="replace-with-real-inbox-identifier"
