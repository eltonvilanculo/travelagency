# next-auth@4.24.15 declares a peerOptional dependency on nodemailer@^7.0.7
# (its own legacy "email provider" magic-link feature, which this project
# doesn't use), but the project's own nodemailer (used directly for
# reservation confirmation emails, src/lib/email.ts) is v10. That's a real
# peer conflict npm's default strict resolver refuses to install past —
# harmless in practice (the conflicting code path is never invoked), but
# it fails a plain `npm install` outright, including on Vercel's build
# machine. legacy-peer-deps matches what every local install this project
# has used to work around the same conflict.
legacy-peer-deps=true
